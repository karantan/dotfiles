#!/usr/bin/env bash
#
# brave-bg — drive Brave from Claude Code without stealing focus.
#
# Background: Chromium raises itself whenever AppleScript *mutates* it
# (`make new tab`, `make new window`, `set URL`, even `open -g`). But it does
# NOT raise itself for `execute ... javascript`. So this script keeps one
# minimized scratch window and does all navigation from inside the page
# (`location.href = ...`), which is a read-shaped Apple Event.
#
# Net effect: one brief flash the first time the scratch window is created
# (focus is restored immediately), then zero interruption after that.
#
# Requires: Brave → View → Developer → Allow JavaScript from Apple Events.
#
# Usage:
#   brave-bg open <url>     navigate the scratch tab, wait for load
#   brave-bg text           print document.body.innerText
#   brave-bg html           print document.documentElement.outerHTML
#   brave-bg js '<expr>'    evaluate JS in the scratch tab, print result
#   brave-bg url            print current URL + title as JSON
#   brave-bg close          close the scratch window
#
# The scratch window is shared. A second agent (or you) running `brave-bg open`
# navigates the same window, so a later `js`/`text`/`html` can silently run
# against a page you never asked for. That turns a read into wrong data, and a
# POST into a request sent to the wrong site. So `open` records the host it
# landed on, and `text`, `html` and `js` refuse to run if the tab has since
# moved to a different one. `url` and `close` are never guarded: `url` is how
# you find out where the window actually went.
#
# To drive a tab you did not open yourself, pass --any-host (or set
# BRAVE_BG_ANY_HOST=1). To get a window nobody else can steal, point
# XDG_CACHE_HOME somewhere private: the window id and expected host are both
# kept under it.
#
set -euo pipefail

APP="Brave Browser"
STATE="${XDG_CACHE_HOME:-${HOME}/.cache}/brave-bg-window"
HOSTSTATE="${XDG_CACHE_HOME:-${HOME}/.cache}/brave-bg-host"
mkdir -p "$(dirname "$STATE")"

ANY_HOST="${BRAVE_BG_ANY_HOST:-}"

# Returned by the guard wrapper instead of the expression's own value. Long and
# specific so a page cannot plausibly produce it by accident.
MISMATCH="__brave_bg_host_mismatch__"

die() { printf 'brave-bg: %s\n' "$*" >&2; exit 1; }

# Wrap a shell string as a JS single-quoted string literal.
js_str() {
  local s=${1//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
}

# Like js_str, but also escapes the line terminators that cannot appear raw
# inside a JS string literal. Needed because the guard passes the caller's
# whole program through as a literal, and those are routinely multi-line.
js_str_multiline() {
  local s=${1//\\/\\\\}
  s=${s//\'/\\\'}
  s=${s//$'\r'/\\r}
  s=${s//$'\n'/\\n}
  s=${s//$'\u2028'/\\u2028}
  s=${s//$'\u2029'/\\u2029}
  printf "'%s'" "$s"
}

brave_running() {
  osascript -e "tell application \"System Events\" to (name of processes) contains \"${APP}\"" 2>/dev/null | grep -q true
}

window_exists() {
  [[ -n "${1:-}" ]] || return 1
  osascript - "$1" <<'AS' 2>/dev/null | grep -q true
on run argv
  set wid to (item 1 of argv) as integer
  tell application "Brave Browser" to return (exists window id wid)
end run
AS
}

# Print the scratch window id, creating a minimized one if needed.
ensure_window() {
  local wid=""
  [[ -f "$STATE" ]] && wid="$(cat "$STATE")"
  if window_exists "$wid"; then
    printf '%s' "$wid"
    return
  fi

  brave_running || die "Brave is not running — start it first (launching it would steal focus)."

  # The one unavoidable raise. Minimize immediately and hand focus back to
  # whatever the user was actually using.
  wid="$(osascript <<'AS'
tell application "System Events" to set orig to name of first process whose frontmost is true
tell application "Brave Browser"
  set w to make new window
  set wid to id of w
  set minimized of w to true
end tell
-- When the minimize animation completes, macOS hands focus to the next window
-- in line -- one of Brave's own. So don't just restore once and hope: keep
-- re-asserting until the original app is actually frontmost again.
-- Re-assert until the original app has been frontmost for several consecutive
-- checks; a single match isn't enough, because Brave grabs focus again when
-- the animation lands.
set stable to 0
repeat 24 times
  delay 0.2
  try
    tell application "System Events"
      if (name of first process whose frontmost is true) is orig then
        set stable to stable + 1
      else
        set stable to 0
        set frontmost of process orig to true
      end if
    end tell
  end try
  if stable is greater than or equal to 4 then exit repeat
end repeat
return wid
AS
)"
  [[ -n "$wid" ]] || die "could not create scratch window"
  printf '%s' "$wid" >"$STATE"
  printf '%s' "$wid"
}

# eval_js <window-id> <javascript>
eval_js() {
  osascript - "$1" "$2" <<'AS'
on run argv
  set wid to (item 1 of argv) as integer
  set theJS to item 2 of argv
  tell application "Brave Browser"
    return execute (active tab of window id wid) javascript theJS
  end tell
end run
AS
}

# The host `open` last landed on, if any.
expected_host() {
  [[ -f "$HOSTSTATE" ]] && cat "$HOSTSTATE" || true
}

# eval_js, but refuses to run if the tab has wandered to another host. The
# check and the caller's program go over in one Apple Event, so this costs no
# extra round trip; `eval` is what keeps multi-statement input behaving exactly
# as it does unguarded, returning the last statement's completion value.
eval_js_guarded() {
  local wid="$1" user="$2" want out
  want="$(expected_host)"

  if [[ -n "$ANY_HOST" || -z "$want" ]]; then
    eval_js "$wid" "$user"
    return
  fi

  out="$(eval_js "$wid" "(function(){var w=$(js_str "$want");if(location.host!==w){return $(js_str "$MISMATCH")+location.host;}return eval($(js_str_multiline "$user"));})()")"

  if [[ "$out" == "${MISMATCH}"* ]]; then
    die "scratch tab is on '${out#"$MISMATCH"}', expected '${want}'.
Something else navigated the shared window. Re-run 'brave-bg open <url>' to
take it back, pass --any-host to act on whatever is loaded, or set
XDG_CACHE_HOME to a private directory to get a window of your own."
  fi
  printf '%s' "$out"
}

cmd_open() {
  local url="${1:-}" wid loaded=""
  [[ -n "$url" ]] || die "usage: brave-bg open <url>"
  [[ "$url" == *://* ]] || url="https://${url}"
  wid="$(ensure_window)"

  # Mark the current document, then navigate from inside it. When the marker
  # is gone and readyState is complete, the *new* document has landed.
  eval_js "$wid" "window.__bgnav=1; location.href=$(js_str "$url"); 1" >/dev/null 2>&1 || \
    die "could not run JS in the scratch tab — is 'Allow JavaScript from Apple Events' enabled in Brave?"

  for _ in $(seq 1 80); do
    sleep 0.25
    loaded="$(eval_js "$wid" \
      "(typeof window.__bgnav==='undefined' && document.readyState==='complete') ? location.href : ''" \
      2>/dev/null || true)"
    [[ -n "$loaded" ]] && break
  done
  [[ -n "$loaded" ]] || die "timed out loading ${url}"

  # Record the host we actually ended on, not the one asked for, so a redirect
  # across hosts does not leave every later command tripping the guard.
  eval_js "$wid" "location.host" >"$HOSTSTATE" 2>/dev/null || rm -f "$HOSTSTATE"

  printf '%s\n' "$loaded"
}

main() {
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --any-host) ANY_HOST=1; shift ;;
      --help) break ;;
      *) die "unknown option: $1" ;;
    esac
  done

  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    open) cmd_open "${1:-}" ;;
    text) eval_js_guarded "$(ensure_window)" "document.body.innerText" ;;
    html) eval_js_guarded "$(ensure_window)" "document.documentElement.outerHTML" ;;
    # Deliberately unguarded: `url` is how you diagnose a guard failure, so it
    # has to answer for whatever is actually loaded.
    url)  eval_js "$(ensure_window)" "JSON.stringify({url:location.href,title:document.title})" ;;
    js)
      [[ -n "${1:-}" ]] || die "usage: brave-bg js '<expression>'"
      eval_js_guarded "$(ensure_window)" "$1"
      ;;
    close)
      local wid=""
      [[ -f "$STATE" ]] && wid="$(cat "$STATE")"
      if window_exists "$wid"; then
        osascript - "$wid" <<'AS' >/dev/null
on run argv
  set wid to (item 1 of argv) as integer
  tell application "Brave Browser" to close window id wid
end run
AS
      fi
      rm -f "$STATE" "$HOSTSTATE"
      ;;
    ""|-h|--help|help)
      sed -n '3,37p' "$0" | sed 's/^# \{0,1\}//'
      ;;
    *) die "unknown command: ${cmd}" ;;
  esac
}

main "$@"
